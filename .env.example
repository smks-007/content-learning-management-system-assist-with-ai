# ─────────────────────────────────────────────────────────────────────
# CLMS — Environment Variables Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────
DB_USERNAME=clms_user
DB_PASSWORD=clms_pass

# ─── JWT ─────────────────────────────────────────────────────────────
# MUST be at least 32 characters for HS256
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# ─── Ollama / AI ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Options: llama3, mistral, deepseek-r1, qwen2.5, codellama
AI_MODEL=llama3

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────────
# Use an App Password if 2FA is enabled on the account.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── File Storage ─────────────────────────────────────────────────────
FILE_UPLOAD_DIR=./uploads

# ─── Frontend ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Stripe (stub / dev mode) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Spring Profile ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
